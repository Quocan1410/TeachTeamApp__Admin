# TeachTeamApp-Admin API — this folder only.
# Copy:  cp env.example .env
# Same MySQL as TeachTeamApp backend (UUID schema). Never DB_SYNC=true on production.

NODE_ENV=development

# --- MySQL (copy from TeachTeamApp backend) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# Same password as TeachTeamApp backend. If it contains # or =, paste the raw
# value in Render (no surrounding quotes). Wrong/truncated password → Access denied.
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp
DB_CONNECTION_LIMIT=10
# disable | preferred | required — match user API (hosted ASP: preferred)
DB_SSL=preferred

# --- HTTP ---
ADMIN_BACKEND_PORT=4002
ADMIN_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Auth ---
# Must match TeachTeamApp backend ADMIN_JWT_SECRET
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin
