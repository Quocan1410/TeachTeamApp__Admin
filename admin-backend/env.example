# TeachTeamApp-Admin API — this folder only.
# Copy:  cp env.example .env
# Do not read the frontend env or a root .env.
# Same MySQL as TeachTeamApp backend. Never DB_SYNC=true on production.

NODE_ENV=development

# --- MySQL (copy these from TeachTeamApp backend / Render user API) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp
# Max connections for this API process. The main API has its own pool.
DB_CONNECTION_LIMIT=10
# disable | preferred | required. Quote the password if it contains #.
DB_SSL=disable

# --- HTTP ---
ADMIN_BACKEND_PORT=4002
ADMIN_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Auth ---
# Same value as TeachTeamApp backend ADMIN_JWT_SECRET
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin
