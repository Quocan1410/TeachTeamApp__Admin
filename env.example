# cp env.example .env — admin repository root
# Point DB_* at the SAME MySQL database as TeachTeamApp (UUID primary keys).
# Leave DB_SYNC unset against a live / shared database. Never DB_SYNC=true on production.

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=teachteam
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp
# Max connections for the admin API. The main API has its own pool — keep both modest.
DB_CONNECTION_LIMIT=10
# disable | preferred | required. Match TeachTeamApp backend DB_SSL.
DB_SSL=disable

NODE_ENV=development

ADMIN_BACKEND_PORT=4002
# Must match TeachTeamApp backend ADMIN_JWT_SECRET (shared avatar / API routes).
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

ADMIN_FRONTEND_PORT=3001
ADMIN_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Same-origin via admin-frontend rewrites (dev). Override for direct backends:
# NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=http://localhost:4002/graphql
NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=/graphql
NEXT_PUBLIC_ADMIN_WS_ENDPOINT=/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/graphql
NEXT_PUBLIC_API_ENDPOINT=/api
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
# MAIN_API_ORIGIN=http://localhost:5000
# ADMIN_GRAPHQL_ORIGIN=http://localhost:4002

# --- Production (mirror TeachTeamApp: Vercel frontend + Render API) ---
# Admin API (Render):
#   NODE_ENV=production
#   DB_* = same values as TeachTeamApp backend (shared MySQL)
#   DB_SSL=required   # if the host requires TLS
#   ADMIN_JWT_SECRET = same as user API
#   ADMIN_SESSION_SECRET = strong unique secret
#   ADMIN_FRONTEND_URL=https://YOUR-ADMIN.vercel.app
#   FRONTEND_URL=https://teach-team-app.vercel.app
#   ALLOWED_ORIGINS=https://YOUR-ADMIN.vercel.app,https://teach-team-app.vercel.app
#   start: npm ci && npm run build && npm start   (admin-backend/)
#
# Admin frontend (Vercel, Root Directory = admin-frontend):
#   MAIN_API_ORIGIN=https://YOUR-USER-API.onrender.com
#   ADMIN_GRAPHQL_ORIGIN=https://YOUR-ADMIN-API.onrender.com
#   NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=/graphql
#   NEXT_PUBLIC_ADMIN_WS_ENDPOINT=/graphql
#   NEXT_PUBLIC_GRAPHQL_ENDPOINT=/graphql
#   NEXT_PUBLIC_API_ENDPOINT=/api
#   NEXT_PUBLIC_ADMIN_APP_URL=https://YOUR-ADMIN.vercel.app
#   NEXT_PUBLIC_FRONTEND_URL=https://teach-team-app.vercel.app
#
# Also on TeachTeamApp (user) after admin is live:
#   ADMIN_GRAPHQL_ORIGIN=https://YOUR-ADMIN-API.onrender.com
#   ADMIN_FRONTEND_URL=https://YOUR-ADMIN.vercel.app
#   ALLOWED_ORIGINS includes the admin Vercel origin
#   Redeploy user frontend so /admin-graphql rewrites hit the admin API
