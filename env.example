# cp env.example .env — admin repository root
# Uses the SAME MySQL database as the main TeachTeamApp API.

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=teachteam
DB_PASSWORD=CHANGE_ME
DB_NAME=teachteamapp

NODE_ENV=development

ADMIN_BACKEND_PORT=4002
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME

ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

ADMIN_FRONTEND_PORT=3001
ADMIN_FRONTEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Same-origin via admin-frontend rewrites (dev). Override for direct backends:
# NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=http://localhost:4002/graphql
NEXT_PUBLIC_ADMIN_GRAPHQL_ENDPOINT=/graphql
NEXT_PUBLIC_ADMIN_WS_ENDPOINT=/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/graphql
NEXT_PUBLIC_API_ENDPOINT=/api
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
# MAIN_API_ORIGIN=http://localhost:5000
# ADMIN_GRAPHQL_ORIGIN=http://localhost:4002
